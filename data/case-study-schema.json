    "rights_component_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "status",
        "licence_or_terms",
        "scope_note",
        "audit_locator"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/rights_component"
        },
        "status": {
          "$ref": "#/$defs/rights_component_status"
        },
        "licence_or_terms": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_note": {
