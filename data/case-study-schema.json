    "code_availability": {
      "type": "string",
      "enum": [
        "publicly-inspectable",
        "partial",
        "unavailable",
        "not-applicable",
        "unknown"
      ],
      "description": "publicly-inspectable: The core source is publicly readable. This states access, not an open-source licence, verified reuse permission or a successful run.\npartial: Some implementation is public but a consequential part is missing.\nunavailable: A required implementation could not be accessed on the audit date.\nnot-applicable: The lawful inspection does not depend on project code; not a completeness failure.\nunknown: Evidence was insufficient to classify source availability.",
      "x-labels": {
