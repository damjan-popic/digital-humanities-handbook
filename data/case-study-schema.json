    "reusable_data_availability": {
      "type": "string",
      "enum": [
        "open-download",
        "mediated-access",
        "sample-only",
        "metadata-only",
        "unavailable",
        "not-applicable",
        "unknown"
      ],
      "description": "open-download: An inspected public download has documented reuse conditions; not necessarily unrestricted or complete.\nmediated-access: A documented request/access process exists; access has not necessarily been granted.\nsample-only: Only a bounded sample has an evidenced reuse path; not the full dataset.\nmetadata-only: Only descriptive/derived records have an evidenced reuse path, not source texts.\nunavailable: No usable authorized data path was verified; public-looking files do not resolve rights.\nnot-applicable: The case does not require a distributed dataset.\nunknown: Access or reuse conditions could not be established.",
      "x-labels": {
