          "sl": "Pogoji niso ugotovljeni"
        },
        "project-declared": {
          "en": "Project-declared terms; scope unverified",
          "sl": "Projekt navaja pogoje; obseg ni preverjen"
        },
        "verified-open": {
          "en": "Open terms verified for stated scope",
          "sl": "Odprti pogoji preverjeni za navedeni obseg"
        },
        "verified-restricted": {
          "en": "Restricted terms verified for stated scope",
          "sl": "Omejeni pogoji preverjeni za navedeni obseg"
        },
        "not-applicable": {
          "en": "Outside the stated scope",
          "sl": "Zunaj navedenega obsega"
        }
      }
