    "rights_component": {
      "type": "string",
      "enum": [
        "code",
        "data",
        "documentation",
        "source-material",
        "images",
        "interface-content"
      ],
      "description": "code: Implementation source and scripts; does not automatically include dependencies or other components.\ndata: Project datasets, annotations or derived outputs in the stated scope; does not silently inherit code or source-material terms.\ndocumentation: README, manuals and explanatory prose; a code declaration need not license documentation.\nsource-material: Underlying texts, transcripts, documents or other sources; access, consent and edition rights remain distinct.\nimages: Visual material, scans and illustrations where relevant; neither subject age nor web access establishes permission.\ninterface-content: Interface text, displayed content and assets in the stated scope; not automatically covered by implementation-code terms.",
      "x-labels": {
        "code": {
