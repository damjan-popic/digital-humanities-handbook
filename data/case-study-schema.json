{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-legacy-baseline": "a728334d2fa2d1f217ffbce20d8a1e5354692806",
  "x-legacy-case-ids": ["CASE-corpus-augmenter","CASE-createai","CASE-fifi","CASE-jezikovni-svetovalec","CASE-korpus-solar-analysis","CASE-ladakh-relations","CASE-medieval-ner","CASE-pracomul","CASE-text-harvester","CASE-vejice-add-in","CASE-wikivir"],
  "title": "Critical case-study catalogue",
  "description": "Generated from data/case-studies.yml and authoritative intertextuality.yml; see data/case-study-metadata.md. Validation is offline.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/case"
  },
  "$defs": {
    "method_domains": {
      "type": "string",
      "enum": [
        "corpus-building",
        "linguistic-annotation",
        "text-analysis",
        "data-modelling",
        "gis",
        "networks",
        "ai-retrieval",
        "scholarly-publishing",
        "writing-support",
        "digital-editions",
        "ocr-htr",
        "accessibility",
        "public-engagement"
      ],
      "description": "corpus-building: Collecting and preparing a bounded corpus, not evidence that collection is representative.\nlinguistic-annotation: Assigning linguistic labels; not a guarantee of annotation accuracy.\ntext-analysis: Comparing textual features; not interpretation without source reading.\ndata-modelling: Representing units and relations; not a neutral or exhaustive model.\ngis: Spatial representation or analysis; not verified coordinates or boundaries.\nnetworks: Constructing or inspecting relations; not proof of historical connection.\nai-retrieval: AI-assisted or retrieval workflows; not validated generated claims.\nscholarly-publishing: Publication infrastructure; not a reviewed or preserved edition.\nwriting-support: Tools supporting writing; not validated language advice.\ndigital-editions: Editorial representation of sources; not an authoritative edition by default.\nocr-htr: Text recognition; not checked transcription.\naccessibility: Accessibility as a subject; not certified conformance.\npublic-engagement: Work with publics; not proof of consent or community authority.",
      "x-labels": {
        "corpus-building": {
          "en": "Corpus building",
          "sl": "Gradnja korpusov"
        },
        "linguistic-annotation": {
          "en": "Linguistic annotation",
          "sl": "Jezikoslovna anotacija"
        },
        "text-analysis": {
          "en": "Text analysis",
          "sl": "Analiza besedil"
        },
        "data-modelling": {
          "en": "Data modelling",
          "sl": "Modeliranje podatkov"
        },
        "gis": {
          "en": "GIS / spatial humanities",
          "sl": "GIS / prostorska humanistika"
        },
        "networks": {
          "en": "Networks",
          "sl": "Omrežja"
        },
        "ai-retrieval": {
          "en": "AI / retrieval",
          "sl": "UI / iskanje virov"
        },
        "scholarly-publishing": {
          "en": "Scholarly publishing",
          "sl": "Znanstveno objavljanje"
        },
        "writing-support": {
          "en": "Writing support",
          "sl": "Podpora pisanju"
        },
        "digital-editions": {
          "en": "Digital editions",
          "sl": "Digitalne izdaje"
        },
        "ocr-htr": {
          "en": "OCR / HTR",
          "sl": "OCR / HTR"
        },
        "accessibility": {
          "en": "Accessibility",
          "sl": "Dostopnost"
        },
        "public-engagement": {
          "en": "Public engagement",
          "sl": "Sodelovanje z javnostjo"
        }
      }
    },
    "source_types": {
      "type": "string",
      "enum": [
        "web-pages",
        "corpus-text",
        "learner-writing",
        "dialogue-transcripts",
        "historical-documents",
        "metadata",
        "structured-records",
        "scholarly-text",
        "office-documents",
        "interaction-transcripts",
        "images",
        "maps",
        "audio"
      ],
      "description": "web-pages: Web documents; public access does not grant redistribution.\ncorpus-text: Text grouped as a corpus; representativeness remains a question.\nlearner-writing: Learner-produced material; consent and privacy require separate evidence.\ndialogue-transcripts: Transcribed interaction, shaped by transcription choices.\nhistorical-documents: Historical records; not automatically public domain in every form.\nmetadata: Descriptions and identifiers; potentially sensitive and fallible.\nstructured-records: Tables or graph records; not verified relationships.\nscholarly-text: Research/reference prose with source-specific rights.\noffice-documents: Document-application inputs; may contain private text.\ninteraction-transcripts: User/system exchanges; publication does not establish participant permission.\nimages: Visual source objects; licences must be checked separately.\nmaps: Cartographic sources; georeferencing is an interpretation.\naudio: Recorded sound; speaker and performance rights remain relevant.",
      "x-labels": {
        "web-pages": {
          "en": "Web pages",
          "sl": "Spletne strani"
        },
        "corpus-text": {
          "en": "Corpus text",
          "sl": "Korpusna besedila"
        },
        "learner-writing": {
          "en": "Learner writing",
          "sl": "Besedila učečih se"
        },
        "dialogue-transcripts": {
          "en": "Dialogue transcripts",
          "sl": "Prepisi dialogov"
        },
        "historical-documents": {
          "en": "Historical documents",
          "sl": "Zgodovinski dokumenti"
        },
        "metadata": {
          "en": "Metadata",
          "sl": "Metapodatki"
        },
        "structured-records": {
          "en": "Structured records",
          "sl": "Strukturirani zapisi"
        },
        "scholarly-text": {
          "en": "Scholarly text",
          "sl": "Znanstvena besedila"
        },
        "office-documents": {
          "en": "Office documents",
          "sl": "Pisarniški dokumenti"
        },
        "interaction-transcripts": {
          "en": "User/AI transcripts",
          "sl": "Prepisi interakcij z UI"
        },
        "images": {
          "en": "Images",
          "sl": "Slike"
        },
        "maps": {
          "en": "Maps",
          "sl": "Zemljevidi"
        },
        "audio": {
          "en": "Audio",
          "sl": "Zvočni posnetki"
        }
      }
    },
    "inspection_depth": {
      "type": "string",
      "enum": [
        "interface-inspected",
        "documentation-inspected",
        "repository-inspected",
        "data-inspected",
        "locally-run",
        "mixed"
      ],
      "description": "interface-inspected: Specific visible interface elements were inspected, not its hidden implementation.\ndocumentation-inspected: Documentation was read; its claims are not independently executed results.\nrepository-inspected: Named source files were read; their execution or advertised correctness is not established.\ndata-inspected: Named data records or exports were inspected, not the whole collection.\nlocally-run: A dated bounded path was executed with recorded inputs/environment/results; not full reproducibility.\nmixed: More than one inspection mode; the audit names each, without implying a run.",
      "x-labels": {
        "interface-inspected": {
          "en": "Interface inspected",
          "sl": "Pregled vmesnika"
        },
        "documentation-inspected": {
          "en": "Documentation inspected",
          "sl": "Pregled dokumentacije"
        },
        "repository-inspected": {
          "en": "Repository inspected",
          "sl": "Pregled repozitorija"
        },
        "data-inspected": {
          "en": "Data inspected",
          "sl": "Pregled podatkov"
        },
        "locally-run": {
          "en": "Locally run",
          "sl": "Lokalni zagon"
        },
        "mixed": {
          "en": "Mixed inspection",
          "sl": "Kombinirani pregled"
        }
      }
    },
    "languages_regions": {
      "type": "string",
      "enum": [
        "slovene",
        "slovenia",
        "spanish",
        "spain",
        "latin",
        "adriatic",
        "ladakh",
        "himalaya",
        "multilingual",
        "not-specified"
      ],
      "description": "slovene: Slovene is materially relevant; not a coverage claim.\nslovenia: Slovenian context; not national representativeness.\nspanish: Spanish-language material or documented scope.\nspain: Spanish regional scope where documented.\nlatin: Latin-language material or documented scope.\nadriatic: Adriatic historical scope where documented.\nladakh: Ladakh-related material; not community authorization.\nhimalaya: Himalayan scope where documented.\nmultilingual: More than one language is materially in scope; not universal language support.\nnot-specified: Inspected evidence does not establish language/region coverage.",
      "x-labels": {
        "slovene": {
          "en": "Slovene",
          "sl": "Slovenščina"
        },
        "slovenia": {
          "en": "Slovenia",
          "sl": "Slovenija"
        },
        "spanish": {
          "en": "Spanish",
          "sl": "Španščina"
        },
        "spain": {
          "en": "Spain",
          "sl": "Španija"
        },
        "latin": {
          "en": "Latin",
          "sl": "Latinščina"
        },
        "adriatic": {
          "en": "Adriatic region",
          "sl": "Jadranski prostor"
        },
        "ladakh": {
          "en": "Ladakh",
          "sl": "Ladak"
        },
        "himalaya": {
          "en": "Himalayan region",
          "sl": "Himalajski prostor"
        },
        "multilingual": {
          "en": "Multilingual",
          "sl": "Večjezično"
        },
        "not-specified": {
          "en": "Not specified",
          "sl": "Ni opredeljeno"
        }
      }
    },
    "code_availability": {
      "type": "string",
      "enum": [
        "open",
        "partial",
        "unavailable",
        "not-applicable",
        "unknown"
      ],
      "description": "open: The advertised core source is publicly inspectable. Reuse permission is a separate rights/licence field; this does not promise a working run.\npartial: Some implementation is public but a consequential part is missing.\nunavailable: A required implementation could not be accessed on the audit date.\nnot-applicable: The lawful inspection does not depend on project code; not a completeness failure.\nunknown: Evidence was insufficient to classify source availability.",
      "x-labels": {
        "open": {
          "en": "Public source code",
          "sl": "Javno dostopna izvorna koda"
        },
        "partial": {
          "en": "Partial source code",
          "sl": "Delno dostopna izvorna koda"
        },
        "unavailable": {
          "en": "Code unavailable",
          "sl": "Koda ni dostopna"
        },
        "not-applicable": {
          "en": "Code not applicable",
          "sl": "Koda ni relevantna"
        },
        "unknown": {
          "en": "Code availability unknown",
          "sl": "Dostopnost kode ni znana"
        }
      }
    },
    "reusable_data_availability": {
      "type": "string",
      "enum": [
        "open-download",
        "mediated-access",
        "sample-only",
        "metadata-only",
        "unavailable",
        "not-applicable",
        "unknown"
      ],
      "description": "open-download: An inspected public download has documented reuse conditions; not necessarily unrestricted or complete.\nmediated-access: A documented request/access process exists; access has not necessarily been granted.\nsample-only: Only a bounded sample has an evidenced reuse path; not the full dataset.\nmetadata-only: Only descriptive/derived records have an evidenced reuse path, not source texts.\nunavailable: No usable authorized data path was verified; public-looking files do not resolve rights.\nnot-applicable: The case does not require a distributed dataset.\nunknown: Access or reuse conditions could not be established.",
      "x-labels": {
        "open-download": {
          "en": "Reusable download",
          "sl": "Prenos za ponovno uporabo"
        },
        "mediated-access": {
          "en": "Mediated access",
          "sl": "Dostop po dogovoru"
        },
        "sample-only": {
          "en": "Sample only",
          "sl": "Samo vzorec"
        },
        "metadata-only": {
          "en": "Metadata only",
          "sl": "Samo metapodatki"
        },
        "unavailable": {
          "en": "Reusable data unavailable",
          "sl": "Podatki za ponovno uporabo niso dostopni"
        },
        "not-applicable": {
          "en": "Data not applicable",
          "sl": "Podatki niso relevantni"
        },
        "unknown": {
          "en": "Data reuse unknown",
          "sl": "Možnost ponovne uporabe podatkov ni znana"
        }
      }
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "verified-open",
        "verified-restricted",
        "mixed",
        "unknown"
      ],
      "description": "verified-open: Explicit open terms cover the material actually proposed for reuse; not all third-party dependencies.\nverified-restricted: Explicit restrictions/access terms are evidenced; this is not legal clearance.\nmixed: Different code/data components have different or incompletely verified terms, described in licence/audit.\nunknown: No applicable licence/permission was verified; absence of a licence is not permission.",
      "x-labels": {
        "verified-open": {
          "en": "Open terms verified",
          "sl": "Odprti pogoji preverjeni"
        },
        "verified-restricted": {
          "en": "Restricted terms verified",
          "sl": "Omejitve preverjene"
        },
        "mixed": {
          "en": "Mixed rights",
          "sl": "Različni pogoji uporabe"
        },
        "unknown": {
          "en": "Rights unknown",
          "sl": "Pravice niso razjasnjene"
        }
      }
    },
    "translation_status": {
      "type": "string",
      "enum": [
        "paired-draft",
        "paired-human-reviewed",
        "english-fallback",
        "slovene-only",
        "not-applicable"
      ],
      "description": "paired-draft: Both case pages exist; human language approval is not claimed.\npaired-human-reviewed: Both pages and named dated human translation-review metadata exist; CI cannot authenticate a review.\nenglish-fallback: No Slovene case page; translated catalogue labels do not count as a translation.\nslovene-only: A Slovene case page exists without an English page; requires explicit editorial scope approval.\nnot-applicable: Reserved for an explicitly deferred catalogue-only record with no case page; not a translation shortcut.",
      "x-labels": {
        "paired-draft": {
          "en": "Paired draft",
          "sl": "Dvojezični osnutek"
        },
        "paired-human-reviewed": {
          "en": "Paired, human-reviewed",
          "sl": "Dvojezično, jezikovno pregledano"
        },
        "english-fallback": {
          "en": "English fallback",
          "sl": "Angleška nadomestna stran"
        },
        "slovene-only": {
          "en": "Slovene only",
          "sl": "Samo slovensko"
        },
        "not-applicable": {
          "en": "Translation not applicable",
          "sl": "Prevod ni relevanten"
        }
      }
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "current",
        "maintenance-unclear",
        "archived",
        "unavailable",
        "deferred"
      ],
      "description": "current: Dated evidence supports active maintenance; not a service-level commitment.\nmaintenance-unclear: Resource may be reachable but sustained maintenance/responsibility is not established.\narchived: Project declares archival/read-only status; not proof of preservation.\nunavailable: Expected public resource was inaccessible on the audit date; not proof it no longer exists.\ndeferred: Editorial use is deferred pending the audited prerequisites; not a deleted case.",
      "x-labels": {
        "current": {
          "en": "Current",
          "sl": "Trenutno vzdrževano"
        },
        "maintenance-unclear": {
          "en": "Maintenance unclear",
          "sl": "Vzdrževanje ni jasno"
        },
        "archived": {
          "en": "Archived",
          "sl": "Arhivirano"
        },
        "unavailable": {
          "en": "Unavailable",
          "sl": "Nedostopno"
        },
        "deferred": {
          "en": "Deferred",
          "sl": "Odloženo"
        }
      }
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "project-description-only",
        "independently-inspected",
        "locally-tested",
        "mixed"
      ],
      "description": "project-description-only: Only self-description supports the case; no independent inspection is claimed.\nindependently-inspected: Specific files/interface/data were checked beyond repeating the description; not independent peer review or absence of editorial involvement.\nlocally-tested: A recorded local result supports bounded claims; not universal functionality.\nmixed: More than one evidence basis is used, explicitly separated in the audit.",
      "x-labels": {
        "project-description-only": {
          "en": "Project description only",
          "sl": "Samo opis projekta"
        },
        "independently-inspected": {
          "en": "Independently inspected evidence",
          "sl": "Samostojno pregledano gradivo"
        },
        "locally-tested": {
          "en": "Locally tested",
          "sl": "Lokalno preizkušeno"
        },
        "mixed": {
          "en": "Mixed evidence",
          "sl": "Različne vrste dokazov"
        }
      }
    },
    "editor_relationship": {
      "type": "string",
      "enum": [
        "editor-owned",
        "collaborative",
        "external"
      ],
      "description": "editor-owned: Repository/project is owned by the handbook editor; no independent endorsement is implied.\ncollaborative: Documented editor participation/fork contribution without sole original ownership.\nexternal: No editorial ownership/collaboration was found in the inspected evidence; disclose later discoveries.",
      "x-labels": {
        "editor-owned": {
          "en": "Editor-owned",
          "sl": "Urednikov projekt"
        },
        "collaborative": {
          "en": "Collaborative",
          "sl": "Sodelovalni projekt"
        },
        "external": {
          "en": "External",
          "sl": "Zunanji projekt"
        }
      }
    },
    "content_standard": {
      "type": "string",
      "enum": [
        "legacy-audited",
        "showcase-v1",
        "deferred"
      ],
      "description": "legacy-audited: Existing page has a dated audit and explicit remediation; it is not a completed showcase.\nshowcase-v1: All required critical-case sections and paired page declarations are validated; not a numbered release or human scholarly approval.\ndeferred: Content is retained/deferred with an audit record; not a completed showcase.",
      "x-labels": {
        "legacy-audited": {
          "en": "Audited legacy case — not v1-complete",
          "sl": "Pregledan podedovani primer — ne izpolnjuje standarda v1"
        },
        "showcase-v1": {
          "en": "Showcase v1 content standard",
          "sl": "Predstavitveni primer po standardu v1"
        },
        "deferred": {
          "en": "Deferred case content",
          "sl": "Priprava primera je odložena"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "slug",
        "title_en",
        "title_sl",
        "page_en",
        "page_sl",
        "project_url",
        "repository_url",
        "method_domains",
        "source_types",
        "inspection_depth",
        "languages_regions",
        "code_availability",
        "reusable_data_availability",
        "rights_status",
        "licence",
        "translation_status",
        "lifecycle_status",
        "evidence_status",
        "editor_relationship",
        "last_checked",
        "content_standard",
        "audit_record",
        "short_summary_en",
        "short_summary_sl",
        "chapter_connections",
        "workflow_connections",
        "connection_remediation"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^CASE-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title_en": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "title_sl": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_en": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^docs/en/case-studies/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_sl": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^docs/sl/case-studies/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s]+$"
        },
        "repository_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "method_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/method_domains"
          }
        },
        "source_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_types"
          }
        },
        "inspection_depth": {
          "$ref": "#/$defs/inspection_depth"
        },
        "languages_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/languages_regions"
          }
        },
        "code_availability": {
          "$ref": "#/$defs/code_availability"
        },
        "reusable_data_availability": {
          "$ref": "#/$defs/reusable_data_availability"
        },
        "rights_status": {
          "$ref": "#/$defs/rights_status"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "translation_status": {
          "$ref": "#/$defs/translation_status"
        },
        "lifecycle_status": {
          "$ref": "#/$defs/lifecycle_status"
        },
        "evidence_status": {
          "$ref": "#/$defs/evidence_status"
        },
        "editor_relationship": {
          "$ref": "#/$defs/editor_relationship"
        },
        "last_checked": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "content_standard": {
          "$ref": "#/$defs/content_standard"
        },
        "audit_record": {
          "type": "string",
          "pattern": "^release/case-study-audit\\.md#case-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "short_summary_en": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "short_summary_sl": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "chapter_connections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^chapters/[a-z0-9-]+\\.md$"
          }
        },
        "workflow_connections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^workflows/[a-z0-9-]+/[a-z0-9-]+\\.md$"
          }
        },
        "connection_remediation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rights_status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "licence": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "licence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "translation_status": {
                "enum": [
                  "paired-draft",
                  "paired-human-reviewed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "page_en": {
                "type": "string"
