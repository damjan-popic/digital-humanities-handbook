    "rights_status": {
      "type": "string",
      "enum": [
        "verified-open",
        "verified-restricted",
        "mixed",
        "unknown",
        "not-applicable"
      ],
      "description": "verified-open: All applicable component records are verified-open within their documented scopes; not a universal grant for dependencies or other material.\nverified-restricted: All applicable component records have verified restricted terms within their scopes; this is not legal clearance.\nmixed: At least one component is verified, but applicable component statuses differ. Consult each record; no single licence covers the whole case.\nunknown: No applicable component has verified terms. Project-declared licences or warnings may still be recorded and must not be discarded.\nnot-applicable: All six components are explicitly outside the documented inspection/reuse scope; not a general exemption from rights.",
      "x-labels": {
        "verified-open": {
          "en": "All applicable components verified open",
          "sl": "Odprti pogoji preverjeni za vse relevantne sestavine"
        },
        "verified-restricted": {
          "en": "All applicable components verified restricted",
          "sl": "Omejeni pogoji preverjeni za vse relevantne sestavine"
        },
        "mixed": {
          "en": "Partly verified or differing component rights",
          "sl": "Delno preverjene ali različne pravice po sestavinah"
        },
        "unknown": {
          "en": "Component rights not verified",
          "sl": "Pravice po sestavinah niso preverjene"
        },
        "not-applicable": {
          "en": "Rights not applicable to declared scope",
          "sl": "Pravice niso relevantne za navedeni obseg"
        }
      }
